APP_ENV=development
APP_NAME=Paperless AI API
# Default without this line: local SQLite file ./paperless-dev.db
DATABASE_URL=postgresql+psycopg://paperless:CHANGE_ME@127.0.0.1:5432/paperless
LOG_LEVEL=INFO
# JSON logs (true) or human-readable text (false)
LOG_JSON=true

# Document storage (see docs/DOCUMENT_IMPORT.md)
STORAGE_DIR=./data
# Plaintext local storage: ONLY for synthetic test documents. Refused when APP_ENV=production.
ALLOW_UNENCRYPTED_STORAGE=true
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
MAX_IMAGE_PIXELS=80000000
REJECT_PDF_ACTIVE_CONTENT=true
