APP_ENV=development
APP_NAME=Paperless AI API
# Default without this line: local SQLite file ./paperless-dev.db
DATABASE_URL=postgresql+psycopg://paperless:CHANGE_ME@127.0.0.1:5432/paperless
LOG_LEVEL=INFO
# JSON logs (true) or human-readable text (false)
LOG_JSON=true

# Document storage (see docs/DOCUMENT_IMPORT.md)
STORAGE_DIR=./data
# Encryption at rest (docs/STORAGE_ENCRYPTION.md). Create with: paperless-admin generate-key
# STORAGE_MASTER_KEY_FILE=/etc/paperless/master.key
# STORAGE_MASTER_KEY=
# STORAGE_OLD_MASTER_KEYS=
# Without a master key: plaintext storage, ONLY for synthetic test documents in development.
ALLOW_UNENCRYPTED_STORAGE=true
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
MAX_IMAGE_PIXELS=80000000
REJECT_PDF_ACTIVE_CONTENT=true

# Authentication (see docs/AUTHENTICATION.md)
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
